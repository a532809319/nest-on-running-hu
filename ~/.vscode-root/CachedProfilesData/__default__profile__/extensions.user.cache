figuration.json"}],"grammars":[{"language":"xml","scopeName":"text.html.vue-html","path":"./syntaxes/vue-html.tmLanguage.json","embeddedLanguages":{"source.js":"javascript"}}],"configuration":{"title":"小程序","properties":{"applets.useWorkspaceDependencies":{"type":"boolean","default":false,"description":"Use dependencies from workspace. Currently only for TypeScript.","scope":"application"},"applets.completion.autoImport":{"type":"boolean","default":true,"description":"Include completion for module export and auto import them"},"applets.completion.scaffoldSnippetSources":{"type":"object","default":{"workspace":"💼","user":"🗒️","applets":"✌"},"properties":{"workspace":{"type":"string","default":"💼","description":"Show Scaffold Snippets from `<WORKSPACE>/.vscode/vetur/snippets`."},"user":{"type":"string","default":"🗒️","description":"Show Scaffold Snippets from `<USER-DATA-DIR>/User/snippets/vetur`."},"applets":{"type":"string","default":"✌","description":"Show Scaffold Snippets bundled in Vetur."}},"description":"Where Vetur source Scaffold Snippets from and how to indicate them. Set a source to \"\" to disable it.\n\n- workspace: `<WORKSPACE>/.vscode/vetur/snippets`.\n- user: `<USER-DATA-DIR>/User/snippets/vetur`.\n- vetur: Bundled in applets.\n\nThe default is:\n```\n\"applets.completion.scaffoldSnippetSources\": {\n  \"workspace\": \"💼\",\n  \"user\": \"🗒️\",\n  \"applets\": \"✌\"\n}\n```\n\nAlternatively, you can do:\n\n```\n\"applets.completion.scaffoldSnippetSources\": {\n  \"workspace\": \"(W)\",\n  \"user\": \"(U)\",\n  \"vetur\": \"(V)\"\n}\n```\n\n"},"applets.completion.tagCasing":{"type":"string","default":"kebab","enum":["initial","kebab"],"enumDescriptions":["use the key in `components: {...}` as is for tag completion and do not force any casing","kebab-case completion for <my-tag>"],"description":"Casing conversion for tag completion"},"applets.grammar.customBlocks":{"type":"object","default":{"docs":"md","i18n":"json"},"description":"Mapping from custom block tag name to language name. Used for generating grammar to support syntax highlighting for custom blocks."},"applets.validation.template":{"type":"boolean","default":true,"description":"Validate vue-html in <template> using eslint-plugin-vue"},"applets.validation.style":{"type":"boolean","default":true,"description":"Validate css/scss/less/postcss in <style>"},"applets.validation.script":{"type":"boolean","default":true,"description":"Validate js/ts in <script>"},"applets.format.enable":{"type":"boolean","default":true,"description":"Enable/disable the Vetur document formatter."},"applets.format.options.tabSize":{"type":"number","default":2,"description":"Number of spaces per indentation level. Inherited by all formatters."},"applets.format.options.useTabs":{"type":"boolean","default":false,"description":"Use tabs for indentation. Inherited by all formatters."},"applets.format.defaultFormatter.html":{"type":"string","default":"prettyhtml","enum":["none","prettyhtml","js-beautify-html","prettier"],"enumDescriptions":["disable formatting","prettyhtml","html formatter of js-beautify","prettier"],"description":"Default formatter for <template> region"},"applets.format.defaultFormatter.pug":{"type":"string","default":"prettier","enum":["none","prettier"],"enumDescriptions":["disable formatting","prettier"],"description":"Default formatter for <template lang='pug'> region"},"applets.format.defaultFormatter.css":{"type":"string","default":"prettier","enum":["none","prettier"],"enumDescriptions":["disable formatting","css formatter using css parser from prettier"],"description":"Default formatter for <style> region"},"applets.format.defaultFormatter.postcss":{"type":"string","default":"prettier","enum":["none","prettier"],"enumDescriptions":["disable formatting","postcss formatter using css parser from prettier"],"description":"Default formatter for <style lang='postcss'> region"},"applets.format.defaultFormatter.scss":{"type":"string","default":"prettier","enum":["non