# 数据库配置
DB_HOST=localhost
DB_PORT=3306
DB_USERNAME=user
DB_PASSWORD=pass
DB_DATABASE=inventory_db

# Redis配置
REDIS_HOST=localhost
REDIS_PORT=6379

# 应用配置
APP_PORT=3001
DB_SYNCHRONIZE=true
IS_PRODUCTION=false

RABBITMQ_URL=amqp://localhost:5672
THROTTLE_TTL=60  #60秒
 THROTTLE_LIMIT=10000  #1000个请求
REDIS_CLUSTER_NODES=redis:8001,redis:8002,redis:8003,redis:8004,redis:8005,redis:8006
